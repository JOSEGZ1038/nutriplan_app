<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permiso de internet (Flutter lo necesita en debug para hot reload). -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Solo en DEBUG: permite http:// (sin cifrar) para hablar con la API
         local en Docker. En producción la API debe usar https://. -->
    <application android:usesCleartextTraffic="true" />
</manifest>